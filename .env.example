# ==============================================================
# APP CARDAPIOS CACIQUE RESTAURANTE — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel.
# NUNCA comite o .env.local. NUNCA exponha a service role key
# com prefixo NEXT_PUBLIC_ (ela ficaria visível no navegador).
# ==============================================================

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role key — SOMENTE no servidor (rota /api/orders).
# A Vercel expõe todas as variáveis ao runtime do Next.js por padrão;
# o que importa é NUNCA importá-la em código que rode no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- WhatsApp ---
# Número do restaurante/da cozinha no formato internacional,
# apenas dígitos, com DDI. Ex.: 5585999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5585999999999

# --- URL pública (usada nos QR Codes e no PWA) ---
NEXT_PUBLIC_APP_URL=https://cacique.vercel.app
